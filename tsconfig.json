{
    "compilerOptions": {
        "target": "ESNext",
        "module": "commonjs",
        "moduleResolution": "node",
        "esModuleInterop": true,
        "strict": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "types": [
            "node",
            "@playwright/test"
        ],
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "src/*"
            ],
            "@/fixtures/*": [
                "src/fixtures/*"
            ],
            "@/support/*": [
                "src/support/*"
            ],
            "@/utils/*": [
                "src/utils/*"
            ]
        }
    },
    "include": [
        "src/**/*",
        "tests/**/*",
        "config/**/*"
    ],
    "exclude": [
        "node_modules",
        "playwright-report",
        "test-results"
    ]
}